# Copy to .env and fill in. Real environment variables always win over this file.

# Web dashboard login password (required in production; default "kilo" if unset).
KILO_WEB_PASSWORD=

# Basic-auth password the backend uses to attach to `kilo serve` (kilo-serve.sh exports it to kilo serve).
KILO_SERVER_PASSWORD=

# Optional IP allowlist: comma-separated IPs/CIDRs. Unset or empty = allow all.
# Example: 127.0.0.1,::1,203.0.113.0/24
ALLOWED_IPS=

# This machine's ZeroTier interface IP; docker-compose binds published ports
# to it. MUST be set — an empty value makes `docker compose up` fail with a
# clear error instead of silently publishing on all interfaces.
ZEROTIER_IP=

# Optional: port for the dedicated kilo serve. kilo-serve.sh,
# sync-kilo-password.sh and docker-compose (KILO_SERVER_URL) all follow this.
# KILO_SERVE_PORT=4096
