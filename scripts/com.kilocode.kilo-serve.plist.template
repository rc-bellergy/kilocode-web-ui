<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Template: scripts/install-kilo-serve.sh substitutes __ROOT__ with the
     current repo absolute path and installs to ~/Library/LaunchAgents/. -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.kilocode.kilo-serve</string>
    <key>ProgramArguments</key>
    <array>
        <string>__ROOT__/scripts/kilo-serve.sh</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/tmp/kilo-serve.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/kilo-serve.err.log</string>
</dict>
</plist>
